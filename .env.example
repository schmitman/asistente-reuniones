# Token personal de Airtable, solo lectura. Nunca lo commitees.
AIRTABLE_TOKEN=

# Proveedor OpenAI-compatible. Para xAI Grok:
#   LLM_PROVIDER=xai
#   LLM_BASE_URL=https://api.x.ai/v1
#   LLM_MODEL=grok-3
# Para OpenAI:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=xai
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
LLM_MODEL=grok-3

# Perfil persistente de Chromium. El login manual de Google queda acá.
MEET_PROFILE_DIR=data/chrome-profile
# false: ventana real (o Xvfb). true: headless, Meet a veces lo bloquea.
MEET_HEADLESS=false
MEET_DISPLAY_NAME=Asistente IA de Mara
MEET_ADMISSION_TIMEOUT_MS=600000
MEET_POLL_MS=1000
MEET_DEBUG=false

# Aviso al entrar. Por defecto no se publica nada hasta que alguien llama al bot.
POST_CONSENT_ON_JOIN=false
CONSENT_MESSAGE=Hola, soy el asistente IA de Mara, tomo notas

# counts: solo cantidades. names: nombre, seniority, perfil y skills (sin contacto).
CHAT_DETAIL_LEVEL=counts
CHAT_MAX_NAMES=5
# Si está en true, en modo names solo nombra fichas con "Clausula Datos".
CHAT_REQUIRE_DATA_CLAUSE=true

SQLITE_PATH=data/asistente.db
TRANSCRIPT_DIR=data/transcripts

# Panel privado. No lo expongas a internet.
PANEL_HOST=127.0.0.1
PANEL_PORT=8787
PANEL_TOKEN=

# Sync. Dejá SYNC_MAX_RECORDS vacío para bajar las bases completas.
AIRTABLE_PAGE_SIZE=100
AIRTABLE_MIN_INTERVAL_MS=220
SYNC_MAX_RECORDS=

# Transcripción por audio (etapa 2). auto: xAI si hay XAI_API_KEY, si no faster-whisper local, si no apagado.
STT_PROVIDER=auto
# Vacío autodetecta el idioma. es / en para sesgar.
STT_LANGUAGE=
STT_DIARIZE=true
# Modo local: python3 -m venv .venv-stt && .venv-stt/bin/pip install faster-whisper
STT_PYTHON=.venv-stt/bin/python
STT_LOCAL_MODEL=small
STT_MIN_SEGMENT_MS=4000
STT_MAX_SEGMENT_MS=15000
STT_SPEECH_RMS=0.01
